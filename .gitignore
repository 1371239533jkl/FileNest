# 环境变量配置（包含敏感信息）
.env

# 本地回收区（删除的文件暂存）
.trash/

# 日志目录
logs/

# 代码索引工具（IDE 自动生成）
.codegraph/

# CodeBuddy 工作数据（仅本地使用）
.codebuddy/

# AI 会话历史（用户数据，不进版本库）
sessions/

# AI 模型配置（包含 API Key）
ai_models.json

# SQLite 数据库文件（本地数据，不进版本库）
*.db
*.db-wal
*.db-shm

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# IDE 配置
.vs/
.vscode/
.idea/

# 系统文件
Thumbs.db
.DS_Store

# PyInstaller 构建产物
build/
build-lite/
dist/
dist-lite/
*.spec
pyinstaller*.log# 功能进度追踪（工作区辅助文档，不进版本库）
docs/PROGRESS.md

# 本地开发文档（除 README.md 外不进版本库）
USER_GUIDE.md
docs/
!docs/README.md
