# 环境变量配置（包含敏感信息）
.env

# 本地回收区（删除的文件暂存）
.trash/

# 日志目录
logs/

# 代码索引工具（IDE 自动生成）
.codegraph/

# CodeBuddy 工作数据（仅本地使用）
.codebuddy/

# AI 会话历史（用户数据，不进版本库）
sessions/

# AI 模型配置（包含 API Key）
ai_models.json

# SQLite 数据库文件（本地数据，不进版本库）
*.db
*.db-wal
*.db-shm

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# IDE 配置
.vs/
.vscode/
.idea/

# 系统文件
Thumbs.db
.DS_Store

# PyInstaller 构建产物
build/
build-lite/
dist/
dist-lite/
*.spec
pyinstaller*.log

# 功能进度追踪（工作区辅助文档，不进版本库）
docs/PROGRESS.md

# 本地开发文档：docs/ 下仅保留 README.md 与展示截图
docs/*
!docs/README.md
!docs/*.png


# 基准数据集（体积大，可用 bench/gen_dataset.py 再生成）
bench/data/

# 重构方案与性能报告（docs/* 默认忽略，需显式放行）
!docs/REFACTOR_PLAN.md
!docs/perf/
!docs/perf/**

# 本地虚拟环境
.venv/

# Node / Electron
desktop/node_modules/

# Electron 打包产物与临时构建目录
desktop/release/
desktop/packaging/dist/
desktop/packaging/build/
desktop/packaging/*.spec

# 进度文档入库（便于跟踪）
!docs/PROGRESS.md

# 构建日志
desktop/*.log
desktop/packaging/*.log

# 项目规则入库（其余 .codebuddy 内容仍忽略）
!.codebuddy/
!.codebuddy/rules/
!.codebuddy/rules/**

# root-temp-log: 根目录临时日志
/*.log
