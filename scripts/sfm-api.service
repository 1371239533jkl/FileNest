[Unit]
Description=Smart File Manager HTTP API (P2-09)
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/sfm/app
Environment=SFM_HOST=0.0.0.0
Environment=SFM_PORT=8765
Environment=SFM_DB=/home/admin/sfm/data/sfm.db
Environment=SFM_API_KEY=f588e8bf8a14aeff83131706d5a3a74521a1049838c0ccba
ExecStart=/home/admin/sfm/venv/bin/python /home/admin/sfm/app/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
